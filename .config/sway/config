# Minimal Void desktop: Sway + Foot + i3status
# See README.md for packages, PipeWire setup and session startup.

### Core Variables
set $mod Mod4

# Navigation
set $left j
set $down k
set $up l
set $right m

# Applications
set $term foot
# Dark surfaces, bright text, blue selection.
set $menu wmenu-run -i -l 8 -f "Iosevka Nerd Font 11" -N 16191F -n F3F4F5 -M 16191F -m 79C0FF -S 245782 -s FFFFFF
set $desktop_action sh $HOME/.config/sway/desktop-action.sh

# Appearance
font pango:Iosevka Nerd Font 11
default_border pixel 2
default_floating_border pixel 2
gaps inner 4
gaps outer 0
smart_gaps on
smart_borders off

### Output Configuration
# Use the monitor's preferred mode; no hardware-specific output names.
output * bg ~/.config/sway/dusk.png fill #718795

include ~/.config/sway/startup.conf

### Input Configuration
input type:keyboard {
    xkb_layout fr
    repeat_delay 300
    repeat_rate 30
}

input type:touchpad {
    tap disabled
    natural_scroll enabled
    scroll_factor 0.5
    dwt enabled
    middle_emulation enabled
}

include ~/.config/sway/bindings.conf

### Window Rules
for_window [app_id="floating_terminal"] floating enable, resize set 800 600, move center

### Color Scheme: Dusk
# class                 border    background text      indicator child_border
client.focused          #8FE5D3   #305B63    #F4FFFC   #FFCA91   #8FE5D3
client.focused_inactive #7896A7   #435A6B    #F3F6F9   #A1BDCD   #7896A7
client.unfocused        #647E90   #354958    #D8E2EB   #7896A7   #647E90
client.urgent           #FFA697   #743F48    #FFF7F4   #FFA697   #FFA697
client.placeholder      #647E90   #354958    #D8E2EB   #7896A7   #647E90
client.background       #607889

bar {
    status_command i3status
    position top
    height 30
    colors {
        statusline #F4F5F3
        background #293E50EB
        separator #879FB0
        focused_workspace    #8FE5D3 #315A60 #EBFFF9
        active_workspace     #7896A7 #40586B #F4F7FA
        inactive_workspace   #00000000 #00000000 #D6E2EB
        urgent_workspace     #FFA697 #743F48 #FFF7F4
        binding_mode         #FFCA91 #624C39 #FFF2DE
    }
}

### Productivity Features

# Focus follows mouse
focus_follows_mouse yes
# No focus wrapping
focus_wrapping no
# Allow older X11 applications when needed.
xwayland enable
