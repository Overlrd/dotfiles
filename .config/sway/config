# Minimal Void desktop: Sway + Foot + i3status
# See README.md for packages, PipeWire setup and session startup.

### Core Variables
set $mod Mod4

# Navigation
set $left j
set $down k
set $up l
set $right m

# Applications
set $term foot
# Dark surfaces, bright text, blue selection.
set $menu wmenu-run -i -l 8 -f "Iosevka Nerd Font 11" -N 16191F -n F3F4F5 -M 16191F -m 79C0FF -S 245782 -s FFFFFF
set $desktop_action sh $HOME/.config/sway/desktop-action.sh

# Appearance
font pango:Iosevka Nerd Font 11
default_border pixel 1
default_floating_border pixel 1
gaps inner 0
gaps outer 0
smart_gaps off
smart_borders off

### Output Configuration
# Use the monitor's preferred mode; no hardware-specific output names.
output * bg #424950 solid_color

include ~/.config/sway/startup.conf

### Input Configuration
input type:keyboard {
    xkb_layout fr
    repeat_delay 300
    repeat_rate 30
}

input type:touchpad {
    tap disabled
    natural_scroll enabled
    scroll_factor 0.5
    dwt enabled
    middle_emulation enabled
}

include ~/.config/sway/bindings.conf

### Window Rules
for_window [app_id="floating_terminal"] floating enable, resize set 800 600, move center

### Color Scheme: Ink
# class                 border    background text      indicator child_border
client.focused          #79C0FF   #233D53    #FFFFFF   #79C0FF   #79C0FF
client.focused_inactive #707984   #252A32    #E4E7EB   #707984   #707984
client.unfocused        #424950   #1B1F26    #B8C0CC   #424950   #424950
client.urgent           #FF7B86   #652E38    #FFFFFF   #FF7B86   #FF7B86
client.placeholder     #707984   #252A32    #E4E7EB   #707984   #707984
client.background      #424950

bar {
    status_command i3status
    position top
    height 28
    colors {
        statusline #F3F4F5
        background #16191F
        separator #707984
        focused_workspace    #79C0FF #245782 #FFFFFF
        active_workspace     #707984 #303640 #F3F4F5
        inactive_workspace   #16191F #16191F #B8C0CC
        urgent_workspace     #FF7B86 #652E38 #FFFFFF
        binding_mode         #FFD580 #503E23 #FFF1D6
    }
}

### Productivity Features

# Focus follows mouse
focus_follows_mouse yes
# No focus wrapping
focus_wrapping no
# Allow older X11 applications when needed.
xwayland enable
