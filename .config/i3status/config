# Workspaces are displayed by Swaybar itself.
general {
    output_format = "i3bar"
    colors = true
    interval = 5
    color_good = "#E6E0D4"
    color_degraded = "#C3A36A"
    color_bad = "#CA786B"
}

order += "ethernet _first_"
order += "wireless _first_"
order += "battery all"
order += "tztime local"

ethernet _first_ {
    format_up = "ETH %ip"
    format_down = ""
}

wireless _first_ {
    format_up = "WIFI %essid"
    format_down = "WIFI down"
}

battery all {
    format = "%status %percentage"
    format_down = ""
}

tztime local {
    format = "%a %d %b %H:%M"
}
