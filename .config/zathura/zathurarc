# Silver UI; PDF content stays faithful until Ctrl+R toggles recolouring.
set font "Iosevka Nerd Font 11"
set scroll-step 100
set zoom-step 5
set window-title-basename true
set selection-clipboard clipboard
set adjust-open best-fit

set default-bg "#E4E7EB"
set default-fg "#242A31"
set statusbar-bg "#CDD2D8"
set statusbar-fg "#242A31"
set inputbar-bg "#CDD2D8"
set inputbar-fg "#242A31"
set completion-bg "#E4E7EB"
set completion-fg "#242A31"
set completion-group-bg "#CDD2D8"
set completion-group-fg "#59616B"
set completion-highlight-bg "#242A31"
set completion-highlight-fg "#E4E7EB"
set index-bg "#E4E7EB"
set index-fg "#242A31"
set index-active-bg "#242A31"
set index-active-fg "#E4E7EB"
set notification-bg "#CDD2D8"
set notification-fg "#242A31"
set notification-warning-bg "#CDD2D8"
set notification-warning-fg "#A63C47"
set notification-error-bg "#242A31"
set notification-error-fg "#E4E7EB"
set highlight-color "rgba(160,160,160,0.4)"
set highlight-active-color "rgba(220,220,220,0.5)"
set render-loading true
set render-loading-bg "#E4E7EB"
set render-loading-fg "#59616B"
set recolor-lightcolor "#292F36"
set recolor-darkcolor "#E4E7EB"
set recolor-keephue true
set recolor false
map <C-r> recolor
